export global Theme {
    // Dark Minimalist Palette (Default)
    in property <color> background: #121214;
    in property <color> surface: #1A1A1E;
    in property <color> surface-hover: #24242A;
    in property <color> surface-active: #2E2E36;
    in property <color> border: #2C2C32;
    in property <color> border-subtle: #202026;

    // Text Colors
    in property <color> text-primary: #EDEDEF;
    in property <color> text-secondary: #8E8E98;
    in property <color> text-muted: #585862;

    // Accent Colors
    in property <color> accent: #3B82F6;
    in property <color> accent-hover: #60A5FA;
    in property <color> accent-active: #2563EB;

    // Status Colors
    in property <color> status-safe: #22C55E;
    in property <color> status-review: #EAB308;
    in property <color> status-danger: #EF4444;
    in property <color> status-info: #38BDF8;

    // Dimensions
    in property <length> radius-sm: 4px;
    in property <length> radius-md: 6px;
    in property <length> font-xs: 11px;
    in property <length> font-sm: 13px;
    in property <length> font-md: 14px;
    in property <length> font-lg: 18px;
    in property <length> font-xl: 22px;
}
